# ── BountyGang configuration ── copy to .env and edit ──────────────────────
# Database
DB_PATH=./data/bountygang.db
DATA_DIR=./data

# Telegram (the ONLY user-facing interface)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Burp Suite
BURP_API_URL=http://127.0.0.1:9866
BURP_API_TOKEN=
BURP_JAR_PATH=C:\Program Files\BurpSuiteCommunity\burpsuite_community.jar
BURP_PROJECT_FILE=
CHROMIUM_PROXY_HOST=127.0.0.1
CHROMIUM_PROXY_PORT=8080

# Discovery
DISCOVERY_PLATFORMS=hackerone,bugcrowd,intigriti,yeswehack
DISCOVERY_FETCH_TIMEOUT=20
DISCOVERY_OFFLINE_MODE=false

# Scope / safety
REQUIRE_APPROVAL=true
MAX_REQUESTS_PER_MINUTE=30
IDOR_MAX_VALIDATION_REQUESTS=12

# AI research assistant: openai | anthropic | gemini | ollama | none
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Reporting
REPORTS_DIR=./data/reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/bountygang.log
